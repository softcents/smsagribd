# ──────────────────────────────────────────────────────────────────────────────
# SMS WhiteInfo BD – Superman API (Port 8081, Admin/Super-user portal)
# ──────────────────────────────────────────────────────────────────────────────

SUPERMAN_API_ADDR=127.0.0.1:8081
SUPERMAN_API_ENV=production
SUPERMAN_API_FRONTEND_ORIGIN=https://sms.whiteinfobd.com

# [REQUIRED] Minimum 32 characters. Must differ from CUSTOMER_API_JWT_SECRET.
SUPERMAN_API_JWT_SECRET=

SUPERMAN_API_TOKEN_TTL=8h
SUPERMAN_API_REMEMBER_TOKEN_TTL=720h

# ── Database (same DB as Customer API) ────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
# [REQUIRED]
DB_DATABASE=
# [REQUIRED]
DB_USERNAME=
DB_PASSWORD=

# [REQUIRED] Laravel APP_KEY – used to encrypt/decrypt gateway credentials
APP_KEY=

CACHE_PREFIX=sms_whiteinfo_

# ── Storage (same root as Customer API) ───────────────────────────────────────
STORAGE_PATH=/var/www/sms-panel/storage/app/private
