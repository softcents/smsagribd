[Unit]
Description=SMS WhiteInfo – Customer API (Port 8082)
Documentation=https://sms.whiteinfobd.com
After=network.target mariadb.service
Requires=mariadb.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/sms-panel/customer-api
EnvironmentFile=/var/www/sms-panel/customer-api/.env
ExecStart=/var/www/sms-panel/customer-api/customer-api
ExecStop=/bin/kill -s SIGTERM $MAINPID

# Graceful shutdown: wait up to 35 seconds for in-flight SMS sends
TimeoutStopSec=35
KillMode=mixed
KillSignal=SIGTERM

Restart=always
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/www/sms-panel/storage

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sms-customer-api

[Install]
WantedBy=multi-user.target
