# ──────────────────────────────────────────────────────────────────────────────
# SMS WhiteInfo BD – SP (Reseller) API (Port 8083)
# ──────────────────────────────────────────────────────────────────────────────

SP_API_ADDR=127.0.0.1:8083
SP_API_ENV=production
SP_API_FRONTEND_ORIGIN=https://sms.whiteinfobd.com

# [REQUIRED] Minimum 32 characters. Must differ from CUSTOMER and SUPERMAN secrets.
SP_API_JWT_SECRET=

SP_API_TOKEN_TTL=8h
SP_API_REMEMBER_TOKEN_TTL=720h

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
# [REQUIRED]
DB_DATABASE=
# [REQUIRED]
DB_USERNAME=
DB_PASSWORD=

APP_KEY=

CACHE_PREFIX=sms_whiteinfo_
STORAGE_PATH=/var/www/sms-panel/storage/app/private
