# ──────────────────────────────────────────────────────────────────────────────
# SMS WhiteInfo BD – Customer API (Port 8082)
# Copy to customer-api/.env and fill ALL required values.
# Variables marked [REQUIRED] cause startup failure if empty.
# Variables matching Laravel names share the same value from the live server.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
CUSTOMER_API_ADDR=127.0.0.1:8082          # Bind address (never 0.0.0.0)
CUSTOMER_API_ENV=production
CUSTOMER_API_FRONTEND_ORIGIN=https://sms.whiteinfobd.com

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
# [REQUIRED] Minimum 32 characters. Generate: openssl rand -hex 32
CUSTOMER_API_JWT_SECRET=

CUSTOMER_API_TOKEN_TTL=8h
CUSTOMER_API_REMEMBER_TOKEN_TTL=720h

# ── Database (matches Laravel DB_* names) ─────────────────────────────────────
# [REQUIRED]
DB_HOST=127.0.0.1
DB_PORT=3306
# [REQUIRED]
DB_DATABASE=
# [REQUIRED]
DB_USERNAME=
DB_PASSWORD=

# ── Laravel APP_KEY (shared with all services – used to decrypt gateway credentials) ──
# [REQUIRED] Same key as on the Laravel server. Format: base64:<43-char-base64>=
APP_KEY=

# ── Cache prefix (matches Laravel CACHE_PREFIX) ───────────────────────────────
CACHE_PREFIX=sms_whiteinfo_

# ── Mail / SMTP (matches Laravel MAIL_* names) ────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SMS WhiteInfo"
MAIL_ENCRYPTION=tls

# ── Storage ───────────────────────────────────────────────────────────────────
# Absolute path to storage/app/private. Must exist with sub-dirs:
#   ids/  live_photos/  trade_licenses/  batches/  uploads/
STORAGE_PATH=/var/www/sms-panel/storage/app/private

# ── Payment (matches Laravel PIPRAPAY_* names) ────────────────────────────────
PIPRAPAY_BASE_URL=https://epay.softcents.com/api
# [REQUIRED]
PIPRAPAY_API_KEY=

# ── Telegram notifications (matches Laravel TELEGRAM_* names) ─────────────────
TELEGRAM_BOT_API_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Background workers ────────────────────────────────────────────────────────
# Set to "true" only after smoke-testing manually. Default: false (safe start)
WORKER_ENABLED=false
SCHEDULER_ENABLED=false

# Ignore pending messages older than N minutes (default: 30)
WORKER_MAX_AGE_MINUTES=30

# Automatically refund cost when purging stale messages (default: true on new server)
PURGE_STALE_REFUND=true
